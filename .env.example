# Copy to .env and fill in real values. .env is gitignored; this file is the
# only place secrets-shaped variables are allowed to appear in the repository.

# --- apex-db --------------------------------------------------------------
# MYSQL_ROOT_PASSWORD is used once, during first container initialisation,
# to create the database and the application user below. The API never
# connects as root.
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=apexmetrics
MYSQL_USER=apex_app
MYSQL_PASSWORD=changeme-app

# Host port for apex-db. Defaults to 3308, not 3306, so this stack does not
# collide with a MySQL instance already running on the host for another
# project. Only relevant for connecting a local client; apex-api always
# reaches the database over the internal Docker network on 3306.
DB_HOST_PORT=3308
