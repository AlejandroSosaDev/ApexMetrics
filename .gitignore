# =============================================================================
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
.eslintcache
.stylelintcache
*.tsbuildinfo
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright
/playwright-report/
/playwright/.cache/
/test-results/
/blob-report/

# =============================================================================
# Docker — local overrides stay out of version control.
# =============================================================================
docker-compose.override.yml
.docker/data/

# =============================================================================
# IDEs and editors
# =============================================================================
.idea/
*.swp
*.swo
*~
.fleet/

# VS Code: share the team-relevant configuration, ignore personal state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# =============================================================================
# Operating system
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =============================================================================
