# =============================================================================
# Secrets — keep at the top so it is never scrolled past during review.
# Only *.example files are tracked; every real value stays local.
# =============================================================================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.pfx
*.p12
appsettings.Local.json
appsettings.*.Local.json
secrets.json

# =============================================================================
# .NET
# =============================================================================
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]64/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
.vs/
artifacts/
project.lock.json
project.fragment.lock.json
*.nupkg
*.snupkg
.packages/

# Test output and coverage
[Tt]est[Rr]esult*/
coverage/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
TestResults/
BenchmarkDotNet.Artifacts/

# =============================================================================
